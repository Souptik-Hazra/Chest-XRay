# Frontend calls the FastAPI backend through the Vite /api proxy.
VITE_API_BASE_URL=/api
# For a hosted Netlify frontend, set this at Netlify build time to:
# VITE_API_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com/api

# Gemini Flash-Lite report generation via LangChain (put real key in backend/.env or repo-root .env):
# GOOGLE_API_KEY=...
# CHESTX_REPORT_MODEL=gemini-3.5-flash-lite
# Backend CORS: set FRONTEND_ORIGIN to the Netlify production URL.
# CORS_ORIGINS=https://your-netlify-preview.netlify.app,https://another-allowed-origin.example
# Never commit real API keys.
